{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EduShare API",
      "type": "npm",
      "script": "start:dev",
      "path": "edushare-backend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "nest",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "successfully started|Nest application successfully|EADDRINUSE"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "edushare" }
    },
    {
      "label": "EduShare Web",
      "type": "npm",
      "script": "dev",
      "path": "edushare-frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:|error"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "edushare" }
    },
    {
      "label": "Chạy EduShare",
      "dependsOn": ["EduShare API", "EduShare Web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
