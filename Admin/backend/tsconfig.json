{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "prisma/seed.ts",
    "../../Login/backend/src/**/*",
    "../../Register/backend/src/**/*",
    "../../ForgotPassword/backend/src/**/*",
    "../../Donor/backend/src/**/*",
    "../../School/backend/src/**/*",
    "../../Warehouse/backend/src/**/*",
    "../../Volunteer/backend/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
