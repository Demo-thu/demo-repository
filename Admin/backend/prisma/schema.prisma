datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  INTAKE_STAFF
  WAREHOUSE_STAFF
  COORDINATOR
  VOLUNTEER
  DONOR
  SCHOOL_REP
}

enum ItemCategory {
  BOOKS
  UNIFORMS
  IT_DEVICES
  STATIONERY
  FURNITURE
  VEHICLES
}

enum ItemConditionGrade {
  GRADE_A
  GRADE_B
  GRADE_C
  REJECTED
}

enum ItemStatus {
  PENDING_INTAKE
  INSPECTED
  REFURBISHING
  READY_FOR_ALLOCATION
  ALLOCATED
  IN_TRANSIT
  DELIVERED
  RECYCLED
}

enum PledgeStatus {
  PENDING
  VERIFIED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum RequisitionStatus {
  PENDING
  APPROVED
  ALLOCATING
  COMPLETED
  REJECTED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WaybillStatus {
  PENDING_PICKUP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum CampaignStatus {
  UPCOMING
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  fullName         String
  phone            String?
  role             Role                 @default(DONOR)
  status           String               @default("ACTIVE")
  refreshTokenHash String?
  profile          UserProfile?
  pledges             DonationPledge[]
  requisitions        SupportRequisition[]
  shifts              VolunteerShift[]
  waybillAssignments  WaybillVolunteer[]
  transferAssignments StockTransferVolunteer[]
  incidentReports     IncidentReport[]
  schoolTransfers      StockTransferOrder[]     @relation("TransferTargetSchool")
  confirmedPlans      AllocationPlan[]         @relation("AllocationAdminConfirmedBy")
  volunteerProofs     DeliveryProof[]          @relation("VolunteerProofReporter")
  inspections         InspectionReport[]
  auditLogs           AuditLog[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("users")
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String?
  address          String?
  city             String?
  district         String?
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_profiles")
}

model DonationPledge {
  id             String               @id @default(uuid())
  code           String               @unique // Format: DN-YYYYMMDD-XXXX
  donorId        String
  donor          User                 @relation(fields: [donorId], references: [id])
  campaignId     String?
  campaign       Campaign?            @relation(fields: [campaignId], references: [id])
  handoverMethod String               @default("DROP_OFF") // DROP_OFF | PICK_UP
  scheduledAt    DateTime?
  address        String?
  contactName    String?
  contactPhone   String?
  status         PledgeStatus         @default(PENDING)
  notes          String?
  cancelReason   String?
  cancelNote     String?
  cancelledAt    DateTime?
  items          DonationPledgeItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("donation_pledges")
}

model DonationPledgeItem {
  id                String         @id @default(uuid())
  pledgeId          String
  pledge            DonationPledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  category          ItemCategory
  name              String
  estimatedQuantity Int
  declaredCondition String?
  photoUrls         String[]
  unit              String         @default("cái")
  resourceItems     ResourceItem[]
  createdAt         DateTime       @default(now())

  @@map("donation_pledge_items")
}

model Warehouse {
  id                String               @id @default(uuid())
  code              String               @unique // WH-DAD, WH-QNA
  name              String
  address           String
  city              String
  managerId         String?
  capacity          Int                  @default(1000)
  items             ResourceItem[]
  shifts            VolunteerShift[]
  outgoingTransfers StockTransferOrder[] @relation("SourceWarehouse")
  incomingTransfers StockTransferOrder[] @relation("TargetWarehouse")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("warehouses")
}

model ResourceItem {
  id             String              @id @default(uuid())
  qrCode         String              @unique // EDU-[CAT]-[TIMESTAMP]-[HASH]
  pledgeItemId   String?
  pledgeItem     DonationPledgeItem? @relation(fields: [pledgeItemId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  category       ItemCategory
  name           String
  grade          ItemConditionGrade?
  status         ItemStatus          @default(PENDING_INTAKE)
  specifications Json?               // Lưu RAM, CPU, Battery, Size, Khối lớp...
  binLocation    String?             // Vị trí kệ: KỆ-A1-TẦNG-2
  receivedAt     DateTime?
  inspections    InspectionReport[]
  allocationItem AllocationItem?
  transferItems  StockTransferItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([qrCode])
  @@index([status])
  @@index([category])
  @@map("resource_items")
}

model InspectionReport {
  id                String             @id @default(uuid())
  resourceItemId    String
  resourceItem      ResourceItem       @relation(fields: [resourceItemId], references: [id], onDelete: Cascade)
  inspectorId       String
  inspector         User               @relation(fields: [inspectorId], references: [id])
  isFunctional      Boolean            @default(true)
  physicalDefects   String?
  recommendedAction String?
  notes             String?
  inspectedAt       DateTime           @default(now())

  @@map("inspection_reports")
}

model StockTransferOrder {
  id                String    @id @default(uuid())
  code              String    @unique // TR-YYYYMMDD-XXXX
  sourceWarehouseId String
  sourceWarehouse   Warehouse @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouseId String?
  targetWarehouse   Warehouse? @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  targetSchoolId    String?
  targetSchool      User?              @relation("TransferTargetSchool", fields: [targetSchoolId], references: [id])
  requisitionId     String?
  requisition       SupportRequisition? @relation(fields: [requisitionId], references: [id])
  deliveryAddress   String?
  createdById       String
  status            String    @default("PENDING") // PENDING, IN_TRANSIT, RECEIVED, CANCELLED
  itemsCount        Int       @default(0)
  recipientName     String?
  recipientPhone    String?
  recipientNote     String?
  dispatchedAt      DateTime?
  receivedAt        DateTime?
  volunteers        StockTransferVolunteer[]
  items             StockTransferItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("stock_transfer_orders")
}

model SupportRequisition {
  id                 String             @id @default(uuid())
  code               String             @unique // REQ-YYYYMMDD-XXXX
  schoolId           String
  school             User               @relation(fields: [schoolId], references: [id])
  title              String
  urgencyLevel       UrgencyLevel       @default(MEDIUM)
  priorityScore            Float              @default(0.0) // Điểm nội bộ, không trả cho trường
  verificationDocUrl       String?
  schoolConfirmationUrl    String?
  committeeConfirmationUrl String?
  description              String?
  studentInfo              Json?
  status                   RequisitionStatus  @default(PENDING)
  items              RequisitionItem[]
  allocationPlan     AllocationPlan?
  transfers          StockTransferOrder[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([priorityScore(sort: Desc)])
  @@map("support_requisitions")
}

model RequisitionItem {
  id                String             @id @default(uuid())
  requisitionId     String
  requisition       SupportRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  category          ItemCategory
  quantityNeeded    Int
  quantityFulfilled Int                @default(0)
  specification     String?
  unit              String?
  reason            String?

  @@map("requisition_items")
}

model AllocationPlan {
  id            String             @id @default(uuid())
  requisitionId String             @unique
  requisition   SupportRequisition @relation(fields: [requisitionId], references: [id])
  approvedById       String
  adminConfirmedAt   DateTime?
  adminConfirmedById String?
  adminConfirmedBy   User?              @relation("AllocationAdminConfirmedBy", fields: [adminConfirmedById], references: [id])
  status             String             @default("PROPOSED") // PROPOSED, CONFIRMED, DISPATCHED
  totalItems         Int                @default(0)
  items         AllocationItem[]
  waybill       Waybill?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("allocation_plans")
}

model AllocationItem {
  id               String         @id @default(uuid())
  allocationPlanId String
  allocationPlan   AllocationPlan @relation(fields: [allocationPlanId], references: [id], onDelete: Cascade)
  resourceItemId   String         @unique
  resourceItem     ResourceItem   @relation(fields: [resourceItemId], references: [id])
  fromWarehouseId  String

  @@map("allocation_items")
}

model Waybill {
  id                  String         @id @default(uuid())
  code                String         @unique // WB-YYYYMMDD-XXXX
  allocationPlanId String         @unique
  allocationPlan   AllocationPlan @relation(fields: [allocationPlanId], references: [id])
  volunteers       WaybillVolunteer[]
  incidents        IncidentReport[]
  status           WaybillStatus  @default(PENDING_PICKUP)
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  proof            DeliveryProof?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("waybills")
}

model DeliveryProof {
  id                    String   @id @default(uuid())
  waybillId             String   @unique
  waybill               Waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  recipientSignatureUrl String   // Chữ ký điện tử
  proofPhotoUrls        String[] // Ảnh minh chứng bàn giao tại trường
  recipientName         String
  recipientTitle        String
  gpsLatitude           Float?
  gpsLongitude          Float?
  signedAt              DateTime @default(now())
  volunteerReportNote   String?
  volunteerPhotoUrls    String[] @default([])
  volunteerReportedAt   DateTime?
  volunteerReporterId   String?
  volunteerReporter     User?    @relation("VolunteerProofReporter", fields: [volunteerReporterId], references: [id])

  @@map("delivery_proofs")
}

model WaybillVolunteer {
  id          String   @id @default(uuid())
  waybillId   String
  volunteerId String
  waybill     Waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  volunteer   User     @relation(fields: [volunteerId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([waybillId, volunteerId])
  @@index([volunteerId])
  @@map("waybill_volunteers")
}

model IncidentReport {
  id           String   @id @default(uuid())
  waybillId    String?
  waybill      Waybill? @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User     @relation(fields: [reporterId], references: [id])
  reason       String
  incidentType String?
  qrCode       String?
  photoUrls    String[] @default([])
  createdAt    DateTime @default(now())

  @@index([waybillId])
  @@index([reporterId])
  @@map("incident_reports")
}

model StockTransferVolunteer {
  id          String             @id @default(uuid())
  transferId  String
  volunteerId String
  transfer    StockTransferOrder @relation(fields: [transferId], references: [id], onDelete: Cascade)
  volunteer   User               @relation(fields: [volunteerId], references: [id])
  createdAt   DateTime           @default(now())

  @@unique([transferId, volunteerId])
  @@index([volunteerId])
  @@map("stock_transfer_volunteers")
}

model StockTransferItem {
  id             String             @id @default(uuid())
  transferId     String
  resourceItemId String
  transfer       StockTransferOrder @relation(fields: [transferId], references: [id], onDelete: Cascade)
  resourceItem   ResourceItem       @relation(fields: [resourceItemId], references: [id])
  createdAt      DateTime           @default(now())

  @@unique([transferId, resourceItemId])
  @@index([resourceItemId])
  @@map("stock_transfer_items")
}

model VolunteerShift {
  id               String    @id @default(uuid())
  volunteerId      String
  volunteer        User      @relation(fields: [volunteerId], references: [id])
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  shiftDate        DateTime
  shiftType        String    // SORTING, PACKING, DELIVERY
  checkInAt        DateTime?
  checkOutAt       DateTime?
  hoursContributed Float     @default(0.0)
  createdAt        DateTime  @default(now())

  @@map("volunteer_shifts")
}

model Campaign {
  id          String           @id @default(uuid())
  slug        String           @unique
  title       String
  description String
  bannerUrl   String?
  startDate   DateTime
  endDate     DateTime
  status      CampaignStatus   @default(ACTIVE)
  targets     CampaignTarget[]
  pledges     DonationPledge[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("campaigns")
}

model CampaignTarget {
  id                         String       @id @default(uuid())
  campaignId                 String
  campaign                   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category                   ItemCategory
  targetQuantity             Int
  currentReceivedQuantity    Int          @default(0)
  currentDistributedQuantity Int          @default(0)

  @@map("campaign_targets")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
