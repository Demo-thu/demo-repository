DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edushare_db?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
REDIS_URL="redis://127.0.0.1:6379"
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
BCRYPT_ROUNDS=12

# Email (Gmail SMTP) - gui ma xac thuc OTP khi quen mat khau. Dung "Mat khau ung dung" (App password) cua Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-gmail-app-password"
FROM_EMAIL="EduShare Vietnam <your-account@gmail.com>"
